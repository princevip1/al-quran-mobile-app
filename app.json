{
  "expo": {
    "name": "Al-Quran & Tafsir",
    "slug": "al-quran-and-tafsir",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alquranandtafsir",
    "userInterfaceStyle": "automatic",
    "description": "Complete Quran with Tafsir in Bangla & English. High-quality audio recitations, offline access, beautiful reading experience.",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alquran.tafsir"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B4965",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.alquran.tafsir",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B4965",
          "dark": {
            "backgroundColor": "#0A1F2E"
          }
        }
      ],
      "expo-localization",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f2c4a4d-a12e-4618-933c-aae21ffabfcb"
      }
    },
    "owner": "princevip"
  }
}
